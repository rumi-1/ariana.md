---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { CATEGORIES, getCategory, type CategoryId } from '../../lib/categories';
import { getArticlesIn } from '../../lib/articles';

export function getStaticPaths() {
  // Peoples has its own dedicated hub (src/pages/peoples/index.astro) — a map and deep-dive
  // atlas, not this plain card grid — so it's excluded here to avoid a duplicate route.
  return CATEGORIES.filter((c) => c.id !== 'peoples').map((c) => ({ params: { category: c.id } }));
}

const { category } = Astro.params;
const info = getCategory(category as string)!;
const articles = await getArticlesIn(category as CategoryId);
---

<BaseLayout title={info.name} description={info.blurb}>
  <p class="eyebrow"><a href="/">Ariana.md</a> / {info.name}</p>
  <h1>{info.name}</h1>
  <p class="lede">{info.blurb}</p>

  {articles.length === 0 ? (
    <p class="empty">No articles in this section yet.</p>
  ) : (
    <ul class="card-grid">
      {articles.map((a) => <ArticleCard article={a} />)}
    </ul>
  )}
</BaseLayout>
