---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search every article on Ariana.md.">
  <h1>Search</h1>
  <p class="lede">Search titles, alternative names, descriptions, and article text.</p>

  <label for="q" class="visually-hidden">Search articles</label>
  <input id="q" class="search-input" type="search" placeholder="Try “Khorasan”, “Dari”, or “Ferdowsi”" autocomplete="off" />

  <p id="status" class="empty" aria-live="polite"></p>
  <ul id="results" class="result-list"></ul>
</BaseLayout>

<script>
  import MiniSearch from 'minisearch';

  type Doc = {
    id: string;
    title: string;
    aliases: string;
    description: string;
    category: string;
    url: string;
    text: string;
  };

  const input = document.getElementById('q') as HTMLInputElement;
  const list = document.getElementById('results') as HTMLUListElement;
  const status = document.getElementById('status') as HTMLParagraphElement;

  const search = new MiniSearch<Doc>({
    fields: ['title', 'aliases', 'description', 'text'],
    storeFields: ['title', 'description', 'category', 'url'],
    searchOptions: {
      boost: { title: 4, aliases: 3, description: 2 },
      prefix: true,
      fuzzy: 0.15,
    },
  });

  // The index is a static file built alongside the site.
  const docs: Doc[] = await fetch('/search-index.json').then((r) => r.json());
  search.addAll(docs);

  function render(query: string) {
    list.replaceChildren();
    if (!query.trim()) {
      status.textContent = '';
      return;
    }
    const hits = search.search(query);
    status.textContent = hits.length === 0 ? 'No matches.' : `${hits.length} ${hits.length === 1 ? 'match' : 'matches'}`;

    for (const hit of hits) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = hit.url;
      a.textContent = hit.title as string;
      const p = document.createElement('p');
      p.textContent = hit.description as string;
      li.append(a, p);
      list.append(li);
    }
  }

  // Keep the query in the URL so a search can be shared or revisited.
  const initial = new URLSearchParams(location.search).get('q') ?? '';
  input.value = initial;
  render(initial);

  input.addEventListener('input', () => {
    const url = new URL(location.href);
    if (input.value) url.searchParams.set('q', input.value);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    render(input.value);
  });
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
